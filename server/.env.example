PORT=5000
# Local (no Docker): mongodb://127.0.0.1:27017/mern_boilerplate
# Docker Compose:    mongodb://mongo:27017/mern_boilerplate
MONGODB_URI=mongodb://127.0.0.1:27017/mern_boilerplate
# Local Vite: http://localhost:5173
# Docker prod UI: http://localhost:8080
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
